+using Server_minor_versions = std::tuple<std::uint16_t, std::uint16_t, bool>;
+
+class RuntimeMinorVersionTest : public RuntimeTest,
+                               public WithParamInterface<Server_minor_versions> {};
+
+TEST_P(RuntimeMinorVersionTest, RejectDuplicateMinorVersionUntilOriginalServerIsDestroyed) {
+    auto runtime = create_runtime();
+    auto const& configuration = connector_factory.get_configuration();
+    auto const& interface = configuration.get_interface();
+    auto const& instance = connector_factory.get_instance();
+    auto const make_configuration = [&configuration, &interface](std::uint16_t minor) {
+        return Server_service_interface_definition{
+            Service_interface_identifier{interface.id, {interface.version.major, minor}},
+            to_num_of_methods(configuration.get_num_methods()),
+            to_num_of_events(configuration.get_num_events())};
+    };
+    auto const first_configuration = make_configuration(std::get<0>(GetParam()));
+    auto const second_configuration = make_configuration(std::get<1>(GetParam()));
+    Server_connector_callbacks_mock first_callbacks;
+    Server_connector_callbacks_mock second_callbacks;
+    auto first = runtime->make_server_connector(first_configuration, instance,
+                                                create_server_callbacks(first_callbacks));
+    ASSERT_TRUE(first.has_value());
+
+    Enabled_server_connector::Uptr enabled;
+    if (std::get<2>(GetParam())) {
+        enabled = Disabled_server_connector::enable(std::move(first.value()));
+    }
+
+    {
+        auto const duplicate = runtime->make_server_connector(
+            second_configuration, instance, create_server_callbacks(second_callbacks));
+        score::Result<Disabled_server_connector::Uptr> const duplicate_service =
+            score::MakeUnexpected(Construction_error::duplicate_service);
+        EXPECT_EQ(duplicate_service, duplicate);
+    }
+
+    enabled.reset();
+    first.value().reset();
+    auto const replacement = runtime->make_server_connector(
+        second_configuration, instance, create_server_callbacks(second_callbacks));
+    EXPECT_TRUE(replacement.has_value());
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    DisabledAndEnabledServers, RuntimeMinorVersionTest,
+    Combine(Values(0, std::numeric_limits<std::uint16_t>::max()),
+            Values(0, std::numeric_limits<std::uint16_t>::max()), Bool()));
+
