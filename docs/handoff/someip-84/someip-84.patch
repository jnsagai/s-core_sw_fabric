+#include <cstdint>
+#include <limits>
+#include <set>
+#include <tuple>
+
+#include "gtest/gtest.h"
+#include "score/socom/impl/service_identifier.hpp"
+
+namespace score::someip_gateway {
+
+using socom::Literal_tag;
+using socom::Service_instance;
+using socom::Service_instance_identifier;
+using socom::Service_interface_identifier;
+
+using Minor_versions = std::tuple<std::uint16_t, std::uint16_t>;
+
+class ServiceInstanceIdentifierMinorVersionTest
+    : public ::testing::TestWithParam<Minor_versions> {};
+
+TEST_P(ServiceInstanceIdentifierMinorVersionTest, MinorVersionsUseSameRegistrationSlot) {
+    Service_instance const instance{"instance", Literal_tag{}};
+    Service_instance_identifier const first{
+        Service_interface_identifier{"service", Literal_tag{}, {1, std::get<0>(GetParam())}},
+        instance};
+    Service_instance_identifier const second{
+        Service_interface_identifier{"service", Literal_tag{}, {1, std::get<1>(GetParam())}},
+        instance};
+    std::set<Service_instance_identifier> registrations{first};
+
+    EXPECT_FALSE(registrations.insert(second).second);
+    EXPECT_EQ(1U, registrations.size());
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    MinorVersionBoundaries, ServiceInstanceIdentifierMinorVersionTest,
+    ::testing::Combine(::testing::Values(0, 1, std::numeric_limits<std::uint16_t>::max()),
+                       ::testing::Values(0, 1, std::numeric_limits<std::uint16_t>::max())));
+
+TEST(ServiceInstanceIdentifierTest, DifferentServiceIdsUseDistinctRegistrationSlots) {
+    Service_instance const instance{"instance", Literal_tag{}};
+    std::set<Service_instance_identifier> registrations{
+        {Service_interface_identifier{"first", Literal_tag{}, {1, 0}}, instance}};
+
+    EXPECT_TRUE(registrations
+                    .insert({Service_interface_identifier{"second", Literal_tag{}, {1, 1}},
+                             instance})
+                    .second);
+}
+
+TEST(ServiceInstanceIdentifierTest, DifferentMajorVersionsUseDistinctRegistrationSlots) {
+    Service_instance const instance{"instance", Literal_tag{}};
+    std::set<Service_instance_identifier> registrations;
+
+    for (auto const major : {0, 1, 255, 65535}) {
+        EXPECT_TRUE(registrations
+                        .insert({Service_interface_identifier{
+                                     "service", Literal_tag{},
+                                     {static_cast<std::uint16_t>(major), 0}},
+                                 instance})
+                        .second);
+    }
+    EXPECT_EQ(4U, registrations.size());
+}
+
+TEST(ServiceInstanceIdentifierTest, DifferentInstancesUseDistinctRegistrationSlots) {
+    Service_interface_identifier const interface{"service", Literal_tag{}, {1, 0}};
+    std::set<Service_instance_identifier> registrations{
+        {interface, Service_instance{"first", Literal_tag{}}}};
+
+    EXPECT_TRUE(registrations.insert({interface, Service_instance{"second", Literal_tag{}}})
+                    .second);
+}
+
+TEST(ServiceInstanceIdentifierTest, SlotCanBeReusedWithNewMinorVersionAfterRemoval) {
+    Service_instance const instance{"instance", Literal_tag{}};
+    Service_instance_identifier const first{
+        Service_interface_identifier{"service", Literal_tag{}, {1, 0}}, instance};
+    Service_instance_identifier const second{
+        Service_interface_identifier{"service", Literal_tag{}, {1, 1}}, instance};
+    std::set<Service_instance_identifier> registrations{first};
+
+    EXPECT_FALSE(registrations.insert(second).second);
+    EXPECT_EQ(1U, registrations.erase(first));
+    EXPECT_TRUE(registrations.insert(second).second);
+    EXPECT_EQ(1U, registrations.size());
+}
+
+}  // namespace score::someip_gateway
