{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-guideline-source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "guideline_ids",
    "license",
    "notice",
    "native_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_guideline_source"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "guideline_ids": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "native_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
