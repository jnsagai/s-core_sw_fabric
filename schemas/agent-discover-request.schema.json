{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/agent-discover-request-v1.json",
  "title": "Agent capability discovery request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "lock",
    "copy_root",
    "workspace",
    "servers",
    "probes",
    "protected_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_discover_request"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "copy_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1
    },
    "probes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "server",
          "tool",
          "arguments"
        ],
        "properties": {
          "server": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    },
    "protected_roots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}
