{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/agent-admit-request-v1.json",
  "title": "Agent pre-call admission request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "lock",
    "role",
    "model_profiles",
    "catalogue",
    "ledger",
    "call",
    "protected_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_admit_request"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_commit",
        "executable_sha256",
        "pages"
      ],
      "properties": {
        "runtime_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "attempt",
        "profile",
        "estimated_input_tokens"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attempt": {
          "enum": [
            "initial",
            "retry",
            "correction_visit",
            "fallback"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "estimated_input_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "protected_roots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}
