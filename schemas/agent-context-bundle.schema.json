{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/agent-context-bundle-v1.json",
  "title": "Agent role context bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "role",
    "lock",
    "inventory_digest",
    "model_profiles_sha256",
    "model_profile",
    "task",
    "workspace",
    "native_sources",
    "allowed_inputs",
    "write_scope",
    "builtin_tools",
    "mcp_tools",
    "data_destinations",
    "expected_output",
    "prohibited_decisions",
    "completion_criteria",
    "uncertainties_to_report",
    "unresolved_assumptions",
    "observation_index",
    "observations",
    "omissions",
    "runtime_agent_config",
    "role_prompt",
    "engineering_readiness",
    "limitations",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_context_bundle"
    },
    "role": {
      "type": "object"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_profiles_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "task": {
      "type": "object"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "dirty_paths",
        "snapshot"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty_paths": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "snapshot": {
          "type": "object"
        }
      }
    },
    "native_sources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "allowed_inputs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "write_scope": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "builtin_tools": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "mcp_tools": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object"
      }
    },
    "data_destinations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "expected_output": {
      "type": "object"
    },
    "prohibited_decisions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "completion_criteria": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "uncertainties_to_report": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "unresolved_assumptions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "observation_index": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "log",
          "record_type",
          "session_id",
          "timestamp",
          "line_sha256",
          "text",
          "origin",
          "baseline",
          "state",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "log": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "record_type": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "origin": {
            "const": "local_observation_hint"
          },
          "baseline": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "current",
              "stale",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "maxItems": 10001,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "runtime_agent_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "status",
        "text"
      ],
      "properties": {
        "format": {
          "const": "fabro_run_toml"
        },
        "status": {
          "const": "candidate_not_executed"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "role_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sha256"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "engineering_readiness": {
      "const": "not_evaluated"
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
