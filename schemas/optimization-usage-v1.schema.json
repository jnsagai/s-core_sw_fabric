{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optimization-usage-v1",
  "title": "optimization-usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "dimensions",
    "metrics",
    "origin",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "optimization_usage"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "task",
        "role",
        "model",
        "workflow",
        "increment"
      ],
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "workflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "increment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "uncached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "model_calls",
        "tool_calls",
        "cost_microusd",
        "wall_milliseconds",
        "correction_visits",
        "escalations",
        "critic_calls"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "uncached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "wall_milliseconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "correction_visits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "escalations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "critic_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "origin": {
      "enum": [
        "runtime_observation",
        "unknown"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
