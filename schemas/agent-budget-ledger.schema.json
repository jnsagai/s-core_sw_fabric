{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/agent-budget-ledger-v1.json",
  "title": "Agent budget ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "role_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_budget_ledger"
    },
    "role_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "call_id",
          "attempt",
          "profile",
          "usage_origin",
          "input_tokens",
          "output_tokens",
          "cost_microusd",
          "wall_seconds"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "attempt": {
            "enum": [
              "initial",
              "retry",
              "correction_visit",
              "fallback"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "usage_origin": {
            "enum": [
              "runtime_observation",
              "unknown"
            ]
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cost_microusd": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "wall_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
