{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-registry-v1",
  "title": "skill-registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "entries",
    "authority",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "skill_registry"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32
    },
    "authority": {
      "const": "procedure_only"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
