{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/runtime-export-v1.json",
  "title": "Portable Fabro runtime export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_package",
    "wire_projection",
    "runtime",
    "binding",
    "run_summary",
    "status",
    "events",
    "checkpoints",
    "stages",
    "questions",
    "blobs",
    "assurance_references",
    "completeness",
    "limitations",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "runtime_export"
    },
    "source_package": {
      "type": "object"
    },
    "wire_projection": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "binding": {
      "type": "object"
    },
    "run_summary": {
      "type": "object"
    },
    "status": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object"
      }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "stages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "blobs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "bytes",
          "base64",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "base64": {
            "type": "string",
            "maxLength": 89478488
          },
          "origin": {
            "enum": [
              "fabric_source",
              "runtime_observation",
              "authenticated_005_reference"
            ]
          }
        }
      }
    },
    "assurance_references": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assessment_digest",
          "assurance_domain",
          "outcome",
          "origin"
        ],
        "properties": {
          "assessment_digest": {
            "$ref": "#/$defs/digest"
          },
          "assurance_domain": {
            "enum": [
              "fixture_contract",
              "production",
              null
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "origin": {
            "enum": [
              "runtime_observation",
              "authenticated_005_reference"
            ]
          }
        }
      }
    },
    "completeness": {
      "enum": [
        "complete",
        "incomplete",
        "unknown"
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
