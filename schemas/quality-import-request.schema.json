{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-import-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "profile",
    "baseline",
    "artifacts",
    "extraction",
    "origin",
    "protected_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_import_request"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "format",
          "role",
          "ref",
          "source_root",
          "units",
          "bindings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "tool": {
            "enum": [
              "clang-tidy",
              "cppcheck",
              "asan",
              "ubsan",
              "codeql"
            ]
          },
          "format": {
            "enum": [
              "clang-tidy-yaml",
              "cppcheck-xml",
              "sarif-2.1.0",
              "asan-text",
              "ubsan-text",
              "text",
              "clang-tidy-text"
            ]
          },
          "role": {
            "enum": [
              "diagnostics",
              "supporting",
              "log"
            ]
          },
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "source_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "units": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "bindings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_digest",
              "profile_sha256",
              "identity_digest"
            ],
            "properties": {
              "source_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "profile_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "identity_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "origin": {
      "enum": [
        "imported_unverified",
        "fixture"
      ]
    },
    "protected_roots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
