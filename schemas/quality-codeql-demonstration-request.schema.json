{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-codeql-demonstration-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "purpose",
    "case",
    "prerequisites",
    "compiler",
    "reporting_toolchain",
    "license",
    "report_patch_mode",
    "timeout_seconds",
    "total_timeout_seconds",
    "output_limit_bytes",
    "protected_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_codeql_demonstration_request"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$"
    },
    "purpose": {
      "const": "software_demonstration"
    },
    "case": {
      "enum": [
        "seeded",
        "corrected"
      ]
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reporting_toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "report_patch_mode": {
      "enum": [
        "unmodified",
        "git_recount"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "total_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "output_limit_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16777216
    },
    "protected_roots": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
