{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/compiler-profile-v1.json",
  "title": "Deterministic compiler profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "canonicalization",
    "semantic_rules",
    "allowed_actions",
    "allowed_native_types",
    "model_capabilities",
    "limits",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "canonicalization": {
      "const": "canonical-json-v1"
    },
    "semantic_rules": {
      "const": "s-core-workflow-v1"
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent",
          "prompt",
          "command",
          "deterministic_check",
          "human",
          "conditional",
          "parallel",
          "parallel_fan_in"
        ]
      }
    },
    "allowed_native_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "start",
          "exit",
          "agent",
          "prompt",
          "command",
          "human",
          "conditional",
          "parallel",
          "parallel.fan_in"
        ]
      }
    },
    "model_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model_allowed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "model_allowed": {
            "type": "boolean"
          },
          "required": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "prohibited": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_bytes",
        "plan_instances",
        "plan_dependencies",
        "mapping_rules",
        "ir_nodes",
        "ir_edges",
        "cyclic_components",
        "package_bytes",
        "native_files",
        "native_file_bytes",
        "native_total_bytes",
        "action_budget"
      ],
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "plan_instances": {
          "type": "integer",
          "minimum": 1
        },
        "plan_dependencies": {
          "type": "integer",
          "minimum": 1
        },
        "mapping_rules": {
          "type": "integer",
          "minimum": 1
        },
        "ir_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "ir_edges": {
          "type": "integer",
          "minimum": 1
        },
        "cyclic_components": {
          "type": "integer",
          "minimum": 1
        },
        "package_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "native_files": {
          "type": "integer",
          "minimum": 1
        },
        "native_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "native_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "action_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_time_seconds",
            "attempts",
            "tool_calls",
            "input_tokens",
            "output_tokens",
            "cost_microunits"
          ],
          "properties": {
            "wall_time_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 1
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "cost_microunits": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
