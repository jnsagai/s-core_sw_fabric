{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "analyzers",
    "decision_policy_ref",
    "guideline_edition",
    "id",
    "language",
    "mapping_state",
    "native_sources",
    "required_obligations",
    "sanitizers",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_profile"
    },
    "analyzers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "role": {
            "enum": [
              "primary",
              "complementary"
            ]
          },
          "state": {
            "enum": [
              "candidate",
              "unimplemented",
              "unavailable",
              "unknown"
            ]
          }
        }
      }
    },
    "decision_policy_ref": {
      "type": "null"
    },
    "guideline_edition": {
      "const": "MISRA C++:2023"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "language": {
      "const": "c++17"
    },
    "mapping_state": {
      "const": "unknown"
    },
    "native_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "id",
          "license",
          "native_status",
          "notice",
          "path",
          "repository",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "native_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "notice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "required_obligations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sanitizers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "enum": [
              "candidate",
              "unimplemented",
              "unavailable",
              "unknown"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "installed_context": {
      "$ref": "quality-installed-context.schema.json"
    }
  }
}
