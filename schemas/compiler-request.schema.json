{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/compiler-request-v1.json",
  "title": "S-CORE deterministic compiler request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inputs", "local_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "execution_mapping", "compiler_profile", "validator_profile"],
      "properties": {
        "plan": {"$ref": "#/$defs/ref"},
        "execution_mapping": {"$ref": "#/$defs/ref"},
        "compiler_profile": {"$ref": "#/$defs/ref"},
        "validator_profile": {"$ref": "#/$defs/ref"}
      }
    },
    "local_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_root", "protected_roots"],
      "properties": {
        "output_root": {"type": "string", "minLength": 1},
        "protected_roots": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "semantic_digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
