{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-disposition-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "requested_kind",
    "origin_digest",
    "finding_index",
    "construct",
    "scope",
    "native_category",
    "rationale",
    "impact",
    "alternatives",
    "compensating_evidence",
    "expires_at",
    "review_triggers",
    "native_metadata",
    "decision_refs",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_disposition_draft"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$"
    },
    "requested_kind": {
      "enum": [
        "correction",
        "false_positive",
        "deviation",
        "recategorization",
        "suppression"
      ]
    },
    "origin_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "construct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "translation_units"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$"
        },
        "translation_units": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        }
      }
    },
    "native_category": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety",
        "security"
      ],
      "properties": {
        "safety": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "security": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "compensating_evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "review_triggers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "native_metadata": {
      "type": "object"
    },
    "decision_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
