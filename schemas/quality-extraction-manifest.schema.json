{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-extraction-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_digest",
    "observations",
    "outer_exit_code",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_extraction_manifest"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "identity_digest",
          "processed_units",
          "extracted_units",
          "exclusions",
          "warnings",
          "errors",
          "failed_queries",
          "filtered_checks",
          "required_reports",
          "phases"
        ],
        "properties": {
          "tool": {
            "enum": [
              "clang-tidy",
              "cppcheck",
              "asan",
              "ubsan",
              "codeql"
            ]
          },
          "identity_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "processed_units": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "extracted_units": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            ]
          },
          "exclusions": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "reason",
                "justification"
              ],
              "properties": {
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "justification": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "errors": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "failed_queries": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "filtered_checks": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required_reports": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "phases": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "role",
                "status",
                "exit_code",
                "timed_out",
                "artifacts"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "role": {
                  "enum": [
                    "extract",
                    "analyze",
                    "report"
                  ]
                },
                "status": {
                  "enum": [
                    "completed",
                    "failed",
                    "missing"
                  ]
                },
                "exit_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "timed_out": {
                  "type": "boolean"
                },
                "artifacts": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        }
      }
    },
    "outer_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
