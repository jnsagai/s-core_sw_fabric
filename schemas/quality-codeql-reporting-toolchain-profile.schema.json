{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-toolchain-profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "dependencies",
    "id",
    "library_dirs",
    "status",
    "tool"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_codeql_reporting_toolchain_profile"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "library_dirs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^Python 3\\.9\\.[0-9]+$"
        }
      }
    }
  }
}
