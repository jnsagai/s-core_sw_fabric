{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/agent-output-check-v1.json",
  "title": "Agent output and write-scope check v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "role_id",
    "context_digest",
    "result_sha256",
    "structure",
    "workspace",
    "changes",
    "violations",
    "outcome",
    "reasons",
    "native_ids_affected",
    "unresolved_assumptions",
    "proposed_next_action",
    "self_reported_checks",
    "evidence_refs",
    "observation_bindings",
    "engineering_readiness",
    "limitations",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_output_check"
    },
    "role_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "structure": {
      "enum": [
        "valid",
        "malformed"
      ]
    },
    "workspace": {
      "type": "object",
      "required": [
        "path",
        "commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "change": {
            "enum": [
              "added",
              "modified",
              "removed"
            ]
          }
        }
      }
    },
    "violations": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "within_bounds",
        "stopped"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "detail": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "native_ids_affected": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "unresolved_assumptions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "proposed_next_action": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "self_reported_checks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "name",
          "result",
          "origin"
        ],
        "properties": {
          "origin": {
            "const": "agent_assertion"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref",
          "verification"
        ],
        "properties": {
          "verification": {
            "const": "not_verified"
          }
        }
      }
    },
    "observation_bindings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "baseline_commit"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "baseline_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "engineering_readiness": {
      "const": "not_evaluated"
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
