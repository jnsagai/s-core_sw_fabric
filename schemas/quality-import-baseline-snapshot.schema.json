{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-import-baseline-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "component",
    "root",
    "files",
    "expected_units",
    "identities",
    "digest",
    "input_digest",
    "source_digest",
    "full_digest",
    "profile"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_import_baseline_snapshot"
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "files": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "expected_units": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      ]
    },
    "identities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "tool_sha256",
          "config_sha256",
          "query_pack",
          "suite",
          "libraries",
          "license",
          "notice"
        ],
        "properties": {
          "id": {
            "enum": [
              "clang-tidy",
              "cppcheck",
              "asan",
              "ubsan",
              "codeql"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "tool_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "query_pack": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version",
                  "sha256"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "suite": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "sha256"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "libraries": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "sha256"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "notice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "minItems": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "full_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "$ref": "quality-import-request.schema.json#/properties/profile"
    }
  }
}
