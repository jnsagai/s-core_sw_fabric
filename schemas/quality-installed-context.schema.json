{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-installed-context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "origin",
    "state",
    "qualification",
    "project_use_eligibility",
    "tools",
    "codeql_pack"
  ],
  "properties": {
    "origin": {
      "enum": [
        "local_unprotected_observation",
        "fixture"
      ]
    },
    "state": {
      "const": "owner_review_pending"
    },
    "qualification": {
      "const": "unknown"
    },
    "project_use_eligibility": {
      "const": "unknown"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolchain",
          "license_notice"
        ],
        "properties": {
          "toolchain": {
            "oneOf": [
              {
                "$ref": "quality-toolchain-profile.schema.json"
              },
              {
                "$ref": "quality-cppcheck-toolchain-profile.schema.json"
              },
              {
                "$ref": "quality-sanitizer-toolchain-profile.schema.json"
              },
              {
                "$ref": "quality-codeql-toolchain-profile.schema.json"
              }
            ]
          },
          "license_notice": {
            "$ref": "#/$defs/notice"
          }
        }
      }
    },
    "codeql_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "manifest_sha256",
        "metadata_sha256",
        "reviewed_source_commit",
        "declared_build_commit",
        "locked_tree",
        "build_tree",
        "state",
        "compiled_artifact_provenance",
        "library_source_provenance",
        "reporting_compatibility",
        "observation_digest",
        "license_notice"
      ],
      "properties": {
        "name": {
          "const": "codeql/misra-cpp-coding-standards"
        },
        "version": {
          "const": "2.61.0"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "declared_build_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "locked_tree": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "build_tree": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "source_trees_equal",
            "source_trees_different",
            "unknown"
          ]
        },
        "compiled_artifact_provenance": {
          "const": "unverified"
        },
        "library_source_provenance": {
          "const": "unverified"
        },
        "reporting_compatibility": {
          "const": "unexecuted"
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_notice": {
          "$ref": "#/$defs/notice"
        }
      }
    }
  },
  "$defs": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "base64"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base64": {
          "type": "string",
          "maxLength": 1398104
        }
      }
    }
  }
}
