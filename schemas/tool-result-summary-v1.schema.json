{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-result-summary-v1",
  "title": "tool-result-summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "raw",
    "preview",
    "truncated",
    "estimate_method",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "tool_result_summary"
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preview": {
      "type": "string",
      "maxLength": 12000
    },
    "truncated": {
      "type": "boolean"
    },
    "estimate_method": {
      "const": "utf8_bytes_upper_bound"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
