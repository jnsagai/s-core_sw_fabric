{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/apm-context-lock-v1.json",
  "title": "S-CORE APM/MCP context package lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "source",
    "files",
    "servers",
    "setup_operations",
    "runtime_client",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "apm_context_lock"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "license",
        "license_path",
        "notice_path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "license_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "notice_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/server"
      }
    },
    "setup_operations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "server",
          "tool",
          "declared_writes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "server": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "declared_writes": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      }
    },
    "runtime_client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protocol_version",
        "compatibility"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "compatibility": {
          "enum": [
            "not_verified",
            "verified"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handshake_seconds",
        "tool_seconds",
        "line_bytes",
        "result_bytes"
      ],
      "properties": {
        "handshake_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "tool_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "line_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "result_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification",
        "schema_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "classification": {
          "enum": [
            "context_read",
            "local_observation_write",
            "setup_privileged"
          ]
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package",
        "manifest",
        "status",
        "unsupported_reason",
        "upstream_launch",
        "launch",
        "expected",
        "startup_writes",
        "tools"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "unsupported_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "upstream_launch": {
          "type": "object"
        },
        "launch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "python_path",
                "module"
              ],
              "properties": {
                "kind": {
                  "const": "python_module"
                },
                "python_path": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "module": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                }
              }
            }
          ]
        },
        "expected": {
          "type": "object"
        },
        "startup_writes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      }
    }
  }
}
