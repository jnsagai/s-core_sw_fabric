    "allowed_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "collector_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "evidence_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "max_age_seconds": {
            "minimum": 0,
            "type": "integer"
          },
          "tool": {
            "additionalProperties": false,
            "properties": {
              "executable_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "name": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "version",
              "executable_digest"
