      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "assurance_domain": {
      "enum": [
        "fixture_contract",
        "production"
      ]
    },
    "authority_source": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
