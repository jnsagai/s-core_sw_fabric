    "freshness_rules": {
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "no_impact": {
          "additionalProperties": false,
          "properties": {
            "allowed_paths": {
              "items": {
                "maxLength": 4096,
                "pattern": "^(?:/(?:subject|policy)/|/as_of$)",
                "type": "string"
