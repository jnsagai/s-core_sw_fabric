        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "applicable_scopes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "purpose": {
            "maxLength": 256,
            "minLength": 1,
