{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-cppcheck-configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "standard",
    "language",
    "platform",
    "max_configs",
    "error_exitcode",
    "xml_version",
    "enable"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_cppcheck_configuration"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "standard": {
      "const": "c++17"
    },
    "language": {
      "const": "c++"
    },
    "platform": {
      "const": "unix64"
    },
    "max_configs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "error_exitcode": {
      "const": 2
    },
    "xml_version": {
      "const": 2
    },
    "enable": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "warning",
          "style",
          "performance",
          "portability",
          "information",
          "missingInclude"
        ]
      }
    }
  }
}
