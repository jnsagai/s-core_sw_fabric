{
  "$id": "urn:score-sw-fabric:source-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "relation_owners": {
            "additionalProperties": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "type": "object"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256",
          "version",
          "relation_owners"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "metamodel": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "metamodel_schema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "mounts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "docname_prefix": {
            "type": "string"
          },
          "path_prefix": {
            "type": "string"
          },
          "source_id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "docname_prefix",
          "path_prefix"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "build_log_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "checked_in_expected",
            "fresh_build"
          ]
        },
        "toolchain_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "origin",
        "argv",
        "toolchain_ref",
        "build_log_sha256",
        "exit_code"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "repository": {
            "pattern": "^https://",
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "repository",
          "commit",
          "root"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "sources",
    "exports",
    "metamodel",
    "mounts",
    "provenance",
    "metamodel_schema"
  ],
  "title": "S-CORE native export manifest v1",
  "type": "object"
}
