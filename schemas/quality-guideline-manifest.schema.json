{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-guideline-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "origin",
    "scope",
    "expected_guidelines",
    "source_refs",
    "rows",
    "review_state",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "quality_guideline_manifest"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "origin": {
      "enum": [
        "fixture",
        "external_unverified"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "files",
        "translation_units"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "translation_units": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "expected_guidelines": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "guideline_id",
              "native_category",
              "applicability",
              "rationale",
              "source_ids"
            ],
            "properties": {
              "guideline_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "native_category": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "applicability": {
                "enum": [
                  "applicable",
                  "not_applicable",
                  "unknown"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "source_ids": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "uniqueItems": true
              }
            }
          },
          "minItems": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ref",
          "license",
          "notice",
          "native_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "notice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "native_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guideline_id",
          "source_ids",
          "mechanisms",
          "expected_evidence",
          "manual_evidence"
        ],
        "properties": {
          "guideline_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true
          },
          "mechanisms": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "automation_class",
                "tool",
                "native_id",
                "identity_digest",
                "availability",
                "enabled",
                "limitations",
                "source_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "kind": {
                  "enum": [
                    "tool",
                    "manual",
                    "audit",
                    "unsupported"
                  ]
                },
                "automation_class": {
                  "enum": [
                    "automatic",
                    "partial",
                    "manual",
                    "audit",
                    "unsupported"
                  ]
                },
                "tool": {
                  "anyOf": [
                    {
                      "enum": [
                        "clang-tidy",
                        "cppcheck",
                        "asan",
                        "ubsan",
                        "codeql"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "native_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "identity_digest": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "availability": {
                  "enum": [
                    "supported",
                    "unsupported",
                    "unknown"
                  ]
                },
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "limitations": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "uniqueItems": true
                },
                "source_ids": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "expected_evidence": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true
          },
          "manual_evidence": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "uniqueItems": true
          }
        }
      }
    },
    "review_state": {
      "const": "pending_human"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
