{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-summary-v1.schema.json",
  "title": "evidence_summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "raw",
    "total",
    "offset",
    "next_offset",
    "omitted_fields",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "evidence_summary"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_fields": {
      "type": "integer",
      "minimum": 0
    },
    "location_gaps": {
      "type": "integer",
      "minimum": 0
    },
    "suppressed": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "enum": [
        "summary",
        "findings",
        "count_by_rule",
        "count_by_path"
      ]
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "keys": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "str",
          "int",
          "float",
          "bool",
          "list",
          "dict",
          "NoneType"
        ]
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "locations",
          "locations_omitted",
          "suppressed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "locations": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            }
          },
          "locations_omitted": {
            "type": "integer",
            "minimum": 0
          },
          "suppressed": {
            "type": "boolean"
          }
        }
      }
    },
    "counts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "count"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 512
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
