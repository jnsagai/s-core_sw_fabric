{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/work-product-plan-v1.json",
  "title": "S-CORE draft work-product plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "planning_status",
    "closure_complete",
    "engineering_readiness",
    "target_namespace",
    "change",
    "semantic_inputs",
    "scopes",
    "coverage",
    "instances",
    "findings",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_kind": {"const": "draft"},
    "planning_status": {"enum": ["complete", "blocked"]},
    "closure_complete": {"type": "boolean"},
    "engineering_readiness": {"const": "not_evaluated"},
    "target_namespace": {"type": "string", "minLength": 1},
    "change": {"type": "object"},
    "semantic_inputs": {"type": "object"},
    "scopes": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "coverage": {"type": "array", "maxItems": 100000, "items": {"type": "object"}},
    "instances": {"type": "array", "maxItems": 10000, "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
