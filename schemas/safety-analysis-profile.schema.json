{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/safety-analysis-profile-v1.json",
  "title": "Pinned native safety-analysis profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "sources",
    "analyses",
    "requirement_directives",
    "architecture_directives",
    "mitigation_issue_pattern",
    "rules",
    "platform_allocation",
    "internal_fault_prefixes",
    "checklist",
    "gates",
    "loop"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "safety_analysis_profile"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "commit",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "analyses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fmea",
        "dfa"
      ],
      "properties": {
        "fmea": {
          "$ref": "#/$defs/analysis"
        },
        "dfa": {
          "$ref": "#/$defs/analysis"
        }
      }
    },
    "requirement_directives": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "architecture_directives": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "mitigation_issue_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "rules": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "check",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "check": {
            "enum": [
              "sufficient_requires_mitigation",
              "valid_requires_mitigation",
              "open_mitigation_requires_issue"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "platform_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "accepted_directives",
        "accepted_work_products"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "accepted_directives": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "accepted_work_products": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "internal_fault_prefixes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "checklist": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "closure"
      ],
      "properties": {
        "design": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "closure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "scope",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}_[0-9]{2}_[0-9]{2}$"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scope": {
          "enum": [
            "component",
            "platform"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directive",
        "work_product",
        "catalogue_field",
        "mandatory",
        "violates",
        "mitigated_by",
        "catalogue"
      ],
      "properties": {
        "directive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "work_product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "catalogue_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mandatory": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "violates": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "mitigated_by": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "catalogue": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 1
        }
      }
    }
  }
}
