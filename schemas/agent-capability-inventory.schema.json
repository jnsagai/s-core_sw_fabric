{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score.dev/schemas/agent-capability-inventory-v1.json",
  "title": "Agent capability inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "lock",
    "source",
    "copy_root",
    "interpreter",
    "workspace",
    "engineering_readiness",
    "limitations",
    "digest",
    "servers",
    "unsupported",
    "probes",
    "upstream_findings",
    "runtime_client",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_capability_inventory"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object"
    },
    "copy_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "interpreter": {
      "type": "object"
    },
    "workspace": {
      "type": "object",
      "required": [
        "path",
        "commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "engineering_readiness": {
      "const": "not_evaluated"
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "observed",
          "findings",
          "workspace_changes",
          "exit_code",
          "stderr_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "available",
              "blocked",
              "unsupported"
            ]
          },
          "observed": {
            "type": [
              "object",
              "null"
            ]
          },
          "findings": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 128
                },
                "detail": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            }
          },
          "workspace_changes": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "change"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "change": {
                  "enum": [
                    "added",
                    "modified",
                    "removed"
                  ]
                }
              }
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stderr_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "probes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "upstream_findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "detail": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "runtime_client": {
      "type": "object"
    },
    "outcome": {
      "enum": [
        "available",
        "blocked"
      ]
    }
  }
}
